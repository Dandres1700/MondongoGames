# Django
DJANGO_DEBUG=true
DJANGO_OFFLINE_MODE=false
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

# Local default DB:
# If you do not set DATABASE_URL or DB_HOST, Django will use sqlite3 (db.sqlite3).
#
# Option 1 (recommended for Render): DATABASE_URL
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
#
# Option 2 (manual postgres fields)
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=10

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_PROFILE=img_profile
